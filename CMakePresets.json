{
  "version": 3,
  "configurePresets": [
    {
      "name": "lightsamplers-base",
      "hidden": true,
      "cacheVariables": {
        "PBRT_LIGHTCUTS_CUT_SIZE": "32",
        "PBRT_LTC_MAX_CUT_SIZE": "64",
        "PBRT_RHT_RESERVOIR_SET_H_SIZE": "16",
        "PBRT_RHT_F_SAMPLES": "2"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "lightsamplers-base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/bin-${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_C_FLAGS": "/Zc:preprocessor",
        "CMAKE_CXX_FLAGS": "/Zc:preprocessor",
        "CMAKE_CUDA_STANDARD": "17",
        "CMAKE_CUDA_COMPILER": "C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v11.8/bin/nvcc.exe",
        "CMAKE_CUDA_FLAGS": "-Xcompiler=/Zc:preprocessor",
        "CMAKE_CUDA_ARCHITECTURES": "89",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "PBRT_OPTIX_PATH": "C:/ProgramData/NVIDIA Corporation/OptiX SDK 7.7.0",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "lightsamplers-base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/bin-${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/usr/bin/gcc",
        "CMAKE_CXX_COMPILER": "/usr/bin/g++",
        "CMAKE_CUDA_STANDARD": "17",
        "CMAKE_CUDA_COMPILER": "/opt/cuda/bin/nvcc",
        "CMAKE_CUDA_ARCHITECTURES": "89",
        "PBRT_OPTIX_PATH": "/opt/optix"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "windows-cpu-base",
      "hidden": true,
      "inherits": "windows-base",
      "cacheVariables": {
        "PBRT_OPTIX_PATH": ""
      }
    },
    {
      "name": "linux-cpu-base",
      "hidden": true,
      "inherits": "linux-base",
      "cacheVariables": {
        "PBRT_OPTIX_PATH": ""
      }
    },
    {
      "name": "windows-x64-debug",
      "displayName": "Windows x64 Debug",
      "inherits": "windows-base",
